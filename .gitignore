# --- Secrets ---
.env
.env.*
!.env.example
secrets.yaml
*.key
.streamlit/secrets.toml

# --- Licensed / manual data (ISM, consensus forecasts, third-party bars) ---
# Everything under data/ stays local, EXCEPT the header-only CSV templates
# in data/manual/templates/ (column names only, no data).
data/*
!data/manual/
data/manual/*
!data/manual/templates/
*.csv
!tests/fixtures/**/*.csv
!data/manual/templates/*.csv

# --- Raw snapshots and local database ---
raw/
snapshots/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
backups/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
